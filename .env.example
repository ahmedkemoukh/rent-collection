# From `npx supabase status` -> API_URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# From `npx supabase status` -> PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# From `npx supabase status` -> SECRET_KEY
# SERVER ONLY: bypasses RLS. Never import it in client code or prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# From `npx supabase status` -> DB_URL (used by Prisma at runtime)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# From `npx supabase status` -> DB_URL (direct connection for Prisma CLI; same as DATABASE_URL locally, pooler is disabled)
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Payment gateway webhook signature key (HMAC-SHA256 of the x_signature field)
GATEWAY_X_SIGNATURE_KEY=test_x_signature_key
